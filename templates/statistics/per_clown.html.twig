{% extends "base.html.twig" %}

{% block title %}{{ 'Statistiken'|trans }}{% endblock %}

{% block content %}
    <h4 class="pt-3">{{ 'Statistiken'|trans }}</h4>
    {{ component('statistics_navigation', { active: 'per_clown' }) }}
    {{ component('statistics_per_clown_navigation', {active: showYears ? 'per_year' : 'infinity'}) }}
    {% if showYears %}
        {{ include('statistics/_per_clown_year_navigation.html.twig', {activeYear: activeYear, years: years, currentType: type}) }}
        <h5 class="pt-2">{{ 'Reguläre Spieltermine'|trans }} {{ activeYear }}</h5>
    {% else %}
        <h5 class="pt-2">{{ 'Reguläre Spieltermine der Ewigkeit'|trans }}</h5>
    {% endif %}

    {{ component('statistics_for_clowns_dropdown', { currentType: type, path: showYears ? path('statistics_per_year', {year: activeYear}) : path('statistics_infinity') }) }}
    <table class="table">
        <thead>
            <tr>
                <th>{{ 'Clown'|trans }}</th>
                <th>{{ type.label }}</th>
                <th>{{ type.labelNumerator }}</th>
                <th>{{ 'Anteil'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for clownWithCounts in clownsWithCounts %}
            <tr>
                <td>{{ clownWithCounts.clown.name }}</td>
                <td>
                    {{ clownWithCounts.denominator }}
                </td>
                <td>
                    {{ clownWithCounts.numerator }}
                </td>
                <td>
                    {% if clownWithCounts.denominator > 0 %}
                        {{ (clownWithCounts.numerator / clownWithCounts.denominator * 100)|round }} %
                    {% else %}
                        --
                    {% endif %}
                </td>
            </tr>
            {% endfor %}

            <tr>
                <th>{{ 'Summe'|trans }}</th>
                <th>
                    {% set totalDenominator = clownsWithCounts|reduce((carry, v) => carry+v.denominator) %}
                    {{ totalDenominator }}
                </th>
                <th>
                    {% set totalNumerator = clownsWithCounts|reduce((carry, v) => carry+v.numerator) %}
                    {{ totalNumerator }}
                </th>
                <th>
                    {% if totalDenominator > 0 %}
                        {{ (totalNumerator / totalDenominator * 100)|round }} %
                    {% else %}
                        --
                    {% endif %}
                </th>
            </tr>
        </tbody>
    </table>
{% endblock %}
