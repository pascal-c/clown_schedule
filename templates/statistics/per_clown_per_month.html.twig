{% extends "base.html.twig" %}

{% block title %}{{ 'Statistiken'|trans }}{% endblock %}

{% block content %}
    <h4 class="pt-3">{{ 'Statistiken'|trans }}</h4>
    {{ component('statistics_navigation', { active: 'per_clown' }) }}
    {{ component('statistics_per_clown_navigation', { active: 'per_month' }) }}
    {{ component('month_navigation', { active: month.key, urlKey: 'statistics' }) }}
    <h5 class="pt-2">{{ 'Reguläre Spieltermine'|trans }} {{ include('schedule/_schedule_title.html.twig', {schedule: schedule}) }}</h5>

    <div>{{ 'Spieltermine (aktuell):'|trans }} {{ currentPlayDatesCount }}</div>
           
    {{ include('statistics/_rating.html.twig', {rating: calculatedRating, name: 'berechnet'|trans, id: 'calculatedRating'}) }}
    {{ include('statistics/_rating.html.twig', {rating: currentRating, name: 'aktuell'|trans, id: 'currentRating'}) }}

    <table class="table">
        <thead>
            <tr>
                <th colspan="1"></th>
                <th colspan="{{ showMaxPerWeek ? 4 : 3 }}">{{ 'Bedingungen'|trans }}</th>
                <th colspan="4" title="{{ 'Das hat die App berechnet'|trans }}">{{ 'berechnet'|trans }}</th>
                <th colspan="2" title="{{ 'Das war der Stand bei Fertigstellung des Spielplans'|trans }}">{{ 'zugeteilt'|trans }}</th>
                <th colspan="2" title="{{ 'So isses jetzt'|trans }}">{{ 'aktuell'|trans }}</th>
            </tr>
            <tr>
                <th>{{ 'Clown'|trans }}</th>
                <th>{{ 'Maximum'|trans }}</th>
                <th>{{ 'Wunsch'|trans }}</th>
                {% if showMaxPerWeek %}
                    <th>{{ 'Max pro Woche'|trans }}</th>
                {% endif %}
                <th>{{ 'Verfügbarkeit'|trans }}</th>
                <th>{{ 'zustehend'|trans }}</th>
                <th>{{ 'Ziel'|trans }}</th>
                <th>{{ 'Spiele'|trans }}</th>
                <th>{{ 'Springer'|trans }}</th>
                <th>{{ 'Spiele'|trans }}</th>
                <th>{{ 'Springer'|trans }}</th>
                <th>{{ 'Spiele'|trans }}</th>
                <th>{{ 'Springer'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for availability in clownAvailabilities %}
            <tr>
                <td>{{ availability.clown.name }}</td>
                <td>
                    {{ availability.maxPlaysMonth }}
                </td>
                <td>
                    {{ availability.wishedPlaysMonth }}
                </td>
                {% if showMaxPerWeek %}
                    <td>
                        {{ availability.softMaxPlaysWeek }}
                    </td>
                {% endif %}
                <td>
                    {{ availability.availabilityRatio ? "#{(availability.availabilityRatio * 100)|round(2)} %" }} 
                </td>
                <td>
                    {{ availability.entitledPlaysMonth|round(2) }}
                </td>
                <td>
                    {{ availability.targetPlays }}
                </td>
                <td>
                    {{ availability.calculatedPlaysMonth }}
                </td>
                <td>
                    {{ availability.calculatedSubstitutions }}
                </td>
                <td>
                    {{ availability.scheduledPlaysMonth }}
                </td>
                <td>
                    {{ availability.scheduledSubstitutions }}
                </td>
                <td>
                    {{ currentPlays[availability.clown.id] }}
                </td>
                <td>
                    {{ currentSubstitutions[availability.clown.id] }}
                </td>
            </tr>
            {% endfor %}
            <tr>
                <th>{{ 'Summe'|trans }}</th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.maxPlaysMonth) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.wishedPlaysMonth) }}
                </th>
                <th>
                    -
                </th>
                {% if showMaxPerWeek %}
                    <th>
                        -
                    </th>
                {% endif %}
                <th>
                    {% set entitledPlaysSum = clownAvailabilities|reduce((carry, v) => carry+v.entitledPlaysMonth) %}
                    {{ entitledPlaysSum|round(2) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.targetPlays) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.calculatedPlaysMonth) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.calculatedSubstitutions) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.scheduledPlaysMonth) }}
                </th>
                <th>
                    {{ clownAvailabilities|reduce((carry, v) => carry+v.scheduledSubstitutions) }}
                </th>
                {% set currentPlaysSum = currentPlays|reduce((carry, v) => carry+v) %}
                <th class="text-{{ currentPlayDatesCount * 2 == currentPlaysSum ? 'success' : 'danger' }}">
                    {{ currentPlaysSum }}
                </th>
                {% set currentSubstitutionsSum = currentSubstitutions|reduce((carry, v) => carry+v) %}
                <th>
                    {{ currentSubstitutionsSum }}
                </th>
            </tr>
        </tbody>
    </table>
{% endblock %}
