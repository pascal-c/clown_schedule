{% extends "base.html.twig" %}

{% block title %}{{ 'Statistiken'|trans }}{% endblock %}

{% block content %}
    <h4 class="pt-3">{{ 'Statistiken'|trans }}</h4>
    {{ component('statistics_navigation', { active: 'per_venue' }) }}
    {{ component('statistics_per_venue_navigation', {active: showYears ? 'per_year' : 'infinity'}) }}
    {% if showYears %}
        {{ include('statistics/_per_venue_year_navigation.html.twig', {activeYear: activeYear, years: years}) }}
        <h5 class="pt-2">{{ 'Spieltermine (reguläre und Zusatztermine)'|trans }} {{ activeYear }}</h5>
    {% else %}
        <h5 class="pt-2">{{ 'Spieltermine (reguläre und Zusatztermine)'|trans }}</h5>
    {% endif %}

    {{ component('statistics_for_venues_dropdown', { currentType: type, path: showYears ? path('statistics_per_venue_per_year', {year: activeYear}) : path('statistics_per_venue_infinity') }) }}
    <table class="table">
        <thead>
            <tr>
                <th>{{ 'Spielort'|trans }}</th>
                <th>{{ 'Spiele gesamt'|trans }}</th>
                <th>{{ 'Reguläre Spiele'|trans }}</th>
                <th>{{ 'Zusatztermine'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for venue in venues %}
            <tr>
                <td>{{ venue.name }}</td>
                <td>
                    {{ venue.totalCount }}
                </td>
                <td>
                    {{ venue.regularCount }}
                </td>
                <td>
                    {{ venue.specialCount }}
                </td>
            </tr>
            {% endfor %}

            <tr>
                <th>{{ 'Summe'|trans }}</th>
                <th>
                    {{ venues|reduce((carry, v) => carry+v.totalCount) }}
                </th>
                <th> 
                    {{ venues|reduce((carry, v) => carry+v.regularCount) }}
                </th>
                <th> 
                    {{ venues|reduce((carry, v) => carry+v.specialCount) }}
                </th>
            </tr>
        </tbody>
    </table>
{% endblock %}
