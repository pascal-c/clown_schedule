<!-- link triggers modal -->
<div>
  <a href="#" data-bs-toggle="modal" data-bs-target="#calculateModal" title="{{ "Spielplan berechnen"|trans }}"><i class="bi bi-calculator"></i> {{ 'Spielplan berechnen'|trans }}</a>
</div>

<div class="modal fade" id="calculateModal" tabindex="-1" aria-labelledby="calculateModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      {{ form_start(form, {attr: {"data-controller": "form"}}) }}
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="calculateModalLabel">{{ schedule.inProgress ? 'Spielplan neu berechnen'|trans : 'Spielplan berechnen'|trans }}</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
      </div>
      <div class="modal-body">
        <p>{{ 'Bei der Spielplanberechnung werden Spieltermine nach Wünschen und Verfügbarkeiten der Clowns automatisch zugeordnet. Im Anschluss können die Zuordnungen noch manuell angepasst werden oder auch neu berechnet werden.'|trans }}</p>
        <p>{{ 'Die Berechnung dauert ca. 90 Sekunden.'|trans }}</p>
        <p>{{ 'Achtung: Nicht vergessen, die Spielplanerstellung abzuschließen! Erst dann werden die Zuordnungen für die Clowns sichtbar.'|trans }}</p>
      </div>
      <div class="modal-footer">
        {{ form_row(form.keep_existing_assignments) }}
        <button type="button" class="btn btn-secondary mb-3" data-bs-dismiss="modal">{{ 'Abbrechen'|trans }}</button>
        {{ form_row(form.calculate_complex) }}
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
