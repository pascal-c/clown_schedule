{% if invoice %}
    <h5 class="pt-2"><i class="bi bi-receipt"></i> {{ 'Rechnungsstatus'|trans }}</h5>
    <p class="text-muted">
        
        <span class="{{ invoice.open ? 'badge bg-secondary'}}">{{ 'Rechnung offen'|trans }}</span>
        > 
        <span class="{{ invoice.issued ? 'badge bg-secondary'}}">{{ 'Rechnung gestellt'|trans }}</span>
        {% if showPayment %}
            > <span class="{{ invoice.paid ? 'badge bg-secondary'}}">{{ 'Rechnung bezahlt'|trans }}</span>
        {% endif %}
        </span>
    </p>

    {% if invoice.open %}
        <p>
            {{ 'Die Rechnung wartet darauf, gestellt zu werden. Bitte klicke auf "Rechnung als gestellt markieren", sobald die Rechnung erstellt und ans Büro gesendet wurde.'|trans }}
        </p>
    {% elseif invoice.issued %}
        <p>{{ 'Die Rechnung wurde gestellt. Sie wartet darauf, bezahlt zu werden.'|trans }}</p>
        <p>{{ 'Du hast Dich vertan und die Rechnung wurde noch gar nicht gestellt? Dann klicke auf "Rechnung als offen markieren".'|trans }}</p>
    {% elseif invoice.paid %}
        <p>{{ 'Die Rechnung wurde bezahlt und ist abgeschlossen.'|trans }}</p>
    {% endif %}

    {{ form(invoiceForm) }}
{% endif %}
