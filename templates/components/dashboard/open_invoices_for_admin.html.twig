{% if invoices.count > 0 %}
    <h4 class="pt-3">{{ 'Zu stellende Rechnungen bis'|trans }} {{ openOverDueMonth.label }}</h4>

    {{ 'Rechnungen, die noch gestellt werden müssten...'|trans }}
    {% for invoice in invoices %}
        <div>
            <div>
                <a href="{{ path('clown_invoice_show', {clownId: invoice.clown.id, monthId: invoice.month.key}) }}">
                    {{ '%name%: Rechnung für %month%'|trans({'%name%': invoice.clown.name, '%month%': invoice.month.label}) }}
                </a>
            </div>
        </div>
    {% endfor %}
{% endif %}
