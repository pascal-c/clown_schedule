{% if invoices.count > 0 %}
    <h4 class="pt-3">Zu bezahlende Rechnungen</h4>

    Rechnungen, die noch bezahlt werden müssten...
    {% for invoice in invoices %}
        <div>
            <div>
                <a href="{{ path('clown_invoice_show', {clownId: invoice.clown.id, monthId: invoice.month.key}) }}">
                    {{ invoice.clown.name }}: Rechnung für {{ invoice.month.label }}
                </a>
            </div>
        </div>
    {% endfor %}
{% endif %}
