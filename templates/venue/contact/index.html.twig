{% extends "venue/base.html.twig" %}

{% block innercontent %}
    {{ component('venue/details_navigation', {venue: venue, active: 'contacts'}) }}

    <table class="table">
        <thead>
            <tr>
                <th scope="col">{{ 'Name'|trans }}</th>
                <th scope="col">{{ 'Funktion'|trans }}</th>
                <th scope="col">{{ 'Email'|trans }}</th>
                <th scope="col">{{ 'Telefon'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for contact in venue.contacts %}
                <tr>
                    <td>
                        {{ contact.fullname }}
                        {% if currentClown.isAdmin %}
                            {{ include('_shared/_edit_link.html.twig', {url: path('venue_contact_edit', {id: venue.id, contact_id: contact.id}), title: "bearbeiten"|trans}) }}
                        {% endif %}
                    </td>
                    <td>{{ contact.function }}</td>
                    <td><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></td>
                    <td>{{ contact.phone }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if currentClown.isAdmin %}
        <div class="container pt-3">
            {{ include('_shared/_create_link.html.twig', {url: path('venue_contact_new', {id: venue.id}), label: "Kontakt anlegen"|trans}) }}
        </div>
    {% endif %}    
{% endblock %}
