<p>
    {{ 'Hey %name%,'|trans({'%name%': changeRequest.requestedBy.name}) }}<br />
</p>

<p>
    {{ 'gute Neuigkeiten!'|trans }}<br />
    {{ '%name% übernimmt Dein Spiel:'|trans({'%name%': changeRequest.requestedTo.name}) }}
</p>

<p>
    {{ changeRequest.playDateToGiveOff.date|date('d.m.Y') }} {{ changeRequest.playDateToGiveOff.name }}
</p>

{% if personalComment is not empty %}
    <p>
        {{ 'Persönliche Nachricht von %name%:'|trans({'%name%': changeRequest.requestedTo.name}) }}
    </p>
    <p>
        <i>{{ personalComment|nl2br }}</i>
    </p>
{% endif %}

<p>
    {{ 'Super, Du musst Dich um nichts weiter kümmern. Ich habe den Spielplan bereits entsprechend aktualisiert.'|trans }}
</p>

<p>
    {{ 'Das Leben ist schön!'|trans }}
    <br />
    {{ 'Deine Dich liebende Spielplan App'|trans }}
</p>
