<p>
    {{ 'Hallo %name%,'|trans({'%name%': changeRequest.requestedTo.name}) }}
</p>

<p>
    {{ '%name% will den Spieltermin scheinbar doch nicht abgeben!'|trans({'%name%': changeRequest.requestedBy.name}) }}<br />
    {{ 'Es ging um:'|trans }}
</p>

<p>
    {{ changeRequest.playDateToGiveOff.date|date('d.m.Y') }} {{ changeRequest.playDateToGiveOff.name }}
</p>

<p>
    {{ 'Warum, kann ich leider auch nicht sagen!'|trans }}
</p>

{% if personalComment is not empty %}
    <p>
        {{ 'Aber %name% hat eine persönliche Nachricht für Dich hinterlassen:'|trans({'%name%': changeRequest.requestedBy.name}) }}
    </p>
    <p>
        <i>{{ personalComment|nl2br }}</i>
    </p>
{% endif %}

<p>
    <br />
    {{ 'Es lebe das Leben!'|trans }}<br />
    {{ 'Deine Spielplan App'|trans }}
</p>
