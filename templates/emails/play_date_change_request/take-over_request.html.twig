<p>
    {{ 'Hey %name%,'|trans({'%name%': changeRequest.requestedTo ? changeRequest.requestedTo.name : 'Leute'|trans}) }}<br />
</p>

<p>
    {{ 'Es gibt einen unbesetzten Spieltermin. %name% sucht jemanden, der diesen Spieltermin übernehmen möchte.'|trans({'%name%': changeRequest.requestedBy.name}) }}
</p>

<p>
    {{ changeRequest.playDateToGiveOff.date|date('d.m.Y') }} {{ changeRequest.playDateToGiveOff.name }}
</p>

{% if personalComment is not empty %}
    <p>
        {{ 'Persönliche Nachricht von %name%:'|trans({'%name%': changeRequest.requestedBy.name}) }}
    </p>
    <p>
        <i>{{ personalComment|nl2br }}</i>
    </p>
{% endif %}

<p>
    {{ 'Du kannst den Spieltermin'|trans }}
    <a href="{{ url('play_date_show', {id: changeRequest.playDateToGiveOff.id }) }}">{{ 'hier übernehmen'|trans }}</a>{{ ', wenn Du willst.'|trans }}<br />
    {{ 'Wer zuerst kommt, mahlt zuerst!'|trans }}<br />
</p>

<p>
    {{ 'Das Leben ist wunderbar!'|trans }}
    <br />
    {{ 'Eure liebende Spielplan App'|trans }}
</p>
