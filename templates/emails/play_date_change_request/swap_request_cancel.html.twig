<p>
    {{ 'Hallo %name%,'|trans({'%name%': swapRequest.requestedTo.name}) }}
</p>

<p>
    {{ '%name% hat seine Tauschanfrage zurückgenommen.'|trans({'%name%': swapRequest.requestedBy.name}) }}<br />
    {{ 'Es ging um:'|trans }}
</p>

<p>
    {{ swapRequest.playDateToGiveOff.date|date('d.m.Y') }} {{ swapRequest.playDateToGiveOff.name }}<br />
    {{ 'gegen:'|trans }}<br />
    {{ swapRequest.playDateWanted.date|date('d.m.Y') }} {{ swapRequest.playDateWanted.name }}<br />
</p>

<p>
    {{ 'Warum, kann ich leider auch nicht sagen!'|trans }}
</p>

{% if personalComment is not empty %}
    <p>
        {{ 'Aber %name% hat eine persönliche Nachricht für Dich hinterlassen:'|trans({'%name%': swapRequest.requestedBy.name}) }}
    </p>
    <p>
        <i>{{ personalComment|nl2br }}</i>
    </p>
{% endif %}

<p>
    <br />
    {{ 'Es lebe das Leben!'|trans }}<br />
    {{ 'Deine Spielplan App'|trans }}
</p>
