<p>
    {{ 'Yippieh %name%!'|trans({'%name%': clown.name}) }}<br />
</p>

<p>
    {% if oldPartner %}
        {{ 'ich wollte Dir nur mitteilen, dass %old% und %new% getauscht haben.'|trans({'%old%': oldPartner.name, '%new%': newPartner.name}) }}
    {% else %}
        {{ 'Gute Neuigkeiten! Du spielst mit %name%.'|trans({'%name%': newPartner.name}) }}
    {% endif %}
</p>

<p>
    {{ 'Es geht um %date% %playDate%.'|trans({'%date%': playDate.date|date('d.m.Y'), '%playDate%': playDate.name}) }}
</p>

<p>
    {{ 'Du spielst dort jetzt mit %new%, statt mit %old%. Jetzt weißte Bescheid.'|trans({'%new%': newPartner.name, '%old%': oldPartner ? oldPartner.name : 'niemandem'|trans}) }}
</p>

<p>
    {{ 'Viel Spaß!'|trans }}
    <br />
    {{ 'Deine Dich liebende Spielplan App'|trans }}
</p>
