{% extends "base.html.twig" %}

{% block content %}
    <h4 class="pt-3">{{ 'Clown bearbeiten'|trans }}</h4>

    {{ form(form) }}
    <p>{{ clown.name }} {{ 'hat die Datenschutzerklärung'|trans }} {{ clown.privacyPolicyAccepted ? "am #{clown.privacyPolicyDateTime|date('d.m.Y')} akzeptiert." : 'noch nicht akzeptiert.' }}</p>
    {{ send_invitation_form ? form(send_invitation_form) }}
    {{ form(delete_form) }}
{% endblock %}
