{% extends "base.html.twig" %}

{% block content %}
    <h4 class="pt-3">{{ 'Clown bearbeiten'|trans }}</h4>

    {{ form(form) }}
    <p>{{ clown.privacyPolicyAccepted 
       ? 'privacy_policy_accepted'|trans({name: clown.name, date: clown.privacyPolicyDateTime}) 
       : 'privacy_policy_not_accepted'|trans({name: clown.name})  }}</p>
    {{ send_invitation_form ? form(send_invitation_form) }}
    {{ form(delete_form) }}
{% endblock %}
