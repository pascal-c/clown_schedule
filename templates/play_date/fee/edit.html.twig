{% extends "base.html.twig" %}

{% block content %}
    <h5 class="pt-3">{{ playDate.venue ? 'Individuelles'|trans ~ ' ' : '' }}{{ 'Honorar für'|trans }} {{ playDate.name }} {{ 'am'|trans }} {{ playDate.date|date('d.m.Y')}} {{ playDate.hasIndividualFee ? 'bearbeiten'|trans : 'anlegen'|trans }}</h5>

    {{ form(form) }}
    {% if not playDate.hasFee %}
        <a href="{{ path('play_date_show', {id: playDate.id}) }}" title="{{ 'Jetzt erstmal kein Honorar anlegen'|trans }}">{{ 'Überspringen'|trans }}</a>
    {% endif %}
{% endblock %}
