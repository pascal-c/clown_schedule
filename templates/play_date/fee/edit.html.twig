{% extends "base.html.twig" %}

{% block content %}
    <h5 class="pt-3">
        {{ playDate.venue ? 'Individuelles'|trans ~ ' ' : '' }}{{ 'Honorar für {playDate} am {date, date}'|trans({playDate: playDate.name, date: playDate.date }) }} {{ playDate.hasIndividualFee ? 'bearbeiten'|trans : 'anlegen'|trans }}</h5>

    {{ form(form) }}
    {% if not playDate.hasFee %}
        <a href="{{ path('play_date_show', {id: playDate.id}) }}" title="{{ 'Jetzt erstmal kein Honorar anlegen'|trans }}">{{ 'Überspringen'|trans }}</a>
    {% endif %}
{% endblock %}
