{% extends "base.html.twig" %}

{% block title %}{{ 'Spieltermin'|trans }}{% endblock %}

{% block content %}
    <h4 class="pt-3">
        {{ playDate.type.value|trans }}
    </h4>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ (not playDate.isPlayDate ? 'Was' : 'Wo')|trans }}</th>
                <td>
                    {% if playDate.venue %}
                        <a class="text-dark" href="{{ path('venue_show', {id: playDate.venue.id}) }}">{{ playDate.name }}</a>
                    {% else %}
                        {{ playDate.name }}
                    {% endif %}
                    {% if can_edit %}
                        {{ include('_shared/_edit_link.html.twig', {url: path('play_date_edit', {id: playDate.id}), title: "Termin bearbeiten"|trans}) }}
                    {% endif %}
                    {% if can_delete %}
                        {{ include('play_date/_delete_link.html.twig', {delete_form: delete_form, delete_recurring_form: delete_recurring_form, playDate: playDate, should_not_delete: should_not_delete}) }}
                    {% endif %}
                    {% if can_cancel %}
                        {{ include('play_date/_cancel_link.html.twig', {cancel_form: cancel_form, playDate: playDate}) }}
                    {% endif %}
                    {% if can_move %}
                        {{ include('play_date/_move_link.html.twig', {move_form: move_form, playDate: playDate}) }}
                    {% endif %}

                    {{ include('play_date/_status_icons.html.twig', {playDate: playDate}) }}
                </td>
            </tr>
            <tr>
                <th>{{ 'Wann'|trans }}</th>
                <td>
                    {{ playDate.date|date('d.m.Y') }} {{ playDate.daytime|trans }}
                    {% if playDate.comment != '' %}
                        <br /><span class="fst-itlic fw-light">{{ playDate.comment|nl2br }}</span>
                    {% endif %}
                    {% if playDate.movedFrom %}
                        <br />{{ 'Verschoben von'|trans }} <a class="text-dark" href="{{ path('play_date_show', {id: playDate.movedFrom.id}) }}">{{ playDate.movedFrom.date|date('d.m.Y') }}</a>
                    {% endif %}
                    {% if playDate.movedTo %}
                        <br />{{ 'Verschoben auf'|trans }} <a class="text-dark" href="{{ path('play_date_show', {id: playDate.movedTo.id}) }}">{{ playDate.movedTo.date|date('d.m.Y') }}</a>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>{{ 'Treffen'|trans }}</th>
                <td>
                    {{ playDate.meetingTime is not empty ? playDate.meetingTime|date('H:i') }}
                </td>
            </tr>
            <tr>
                <th>{{ (playDate.isPlayDate ? 'Spielzeit' : 'Zeitraum')|trans }}</th>
                <td>
                    {{ playDate.playTimeFrom is not empty ? playDate.playTimeFrom|date('H:i') }} - {{ playDate.playTimeTo is not empty ? playDate.playTimeTo|date('H:i') }}
                </td>
            </tr>
            <tr>
                <th>{{ (playDate.isPlayDate ? 'Spielende Clowns' : 'Teilnehmende')|trans }}</th>
                <td>
                    {{ playDate.playingClowns|map(clown => clown.name)|join(' | ') }}
                    {% if can_assign %}
                        {{ include('_shared/_edit_link.html.twig', {url: path('play_date_assign_clowns', {id: playDate.id}), title: "Zuordnung bearbeiten"|trans}) }}
                    {% endif %}
                </td>
            </tr>
            {% if playDate.isPlayDate %}
                <tr>
                    <th>{{ 'Springer:in'|trans }}</th>
                    <td>
                        {{ playDate.substitutionClowns|map(clown => clown ? clown.name : '---')|join(' | ') }}
                    </td>
                </tr>
            {% endif %}
            {% if playDate.isPaid and config.featureInvoiceManagementClowns %}
                <tr>
                    <th>{{ 'Honorar'|trans }}</th>
                    <td>
                        {% if playDate.fee %}
                            {{ playDate.fee.feeStandard|format_currency('EUR') }} {{ config.featureAlternativeFee ? "/ #{playDate.fee.feeAlternative|format_currency('EUR')}" }}
                            {% if currentClown.isAdmin and playDate.playDateFee %}
                                {{ include('_shared/_edit_link.html.twig', {url: path('play_date_fee_edit', {id: playDate.id}), title: "Honorar bearbeiten"|trans}) }}
                            {% else %}
                                {{ include('_shared/_create_link.html.twig', {url: path('play_date_fee_edit', {id: playDate.id}), title: "individuelles Honorar anlegen"|trans, if: currentClown.isAdmin}) }}
                            {% endif %}
                        {% else %}    
                            ?
                            {{ include('_shared/_create_link.html.twig', {url: path('play_date_fee_edit', {id: playDate.id}), label: "Honorar anlegen"|trans, if: currentClown.isAdmin}) }}
                        {% endif %}
                    </td>
                </tr>
                {% if playDate.fee %}
                    <tr>
                        <th>{{ 'Kilometergeld'|trans }}</th>
                        <td>
                                {{ include('_shared/_kilometer_fee.html.twig', {fee: playDate.fee}) }}
                        </td>
                    </tr>
                {% endif %}
                <tr>
                    <th>{{ 'wiederkehrend'|trans }}</th>
                    <td>
                    {% if playDate.recurringDate %}
                        {% if playDate.recurringDate.isWeekly %}
                            {{ 'jeden %day%'|trans({'%day%': playDate.recurringDate.dayOfWeek|trans}) }} {{ "every.week"|trans({'%weeks%': playDate.recurringDate.every}) }}
                        {% else %}
                            {{ 'jeden'|trans }} {{ playDate.recurringDate.every }}. {{ playDate.recurringDate.dayOfWeek|trans }} {{ 'im Monat'|trans }}
                        {% endif %}
                    {% else %}    
                        {{ 'nein'|trans }}
                    {% endif %}
                        
                    </td>
                </tr>
            {% endif %}
            {% if playDate.bundle %}
                <tr>
                    <th>{{ 'gebündelt mit'|trans }}</th>
                    <td>
                    {% for bundledPlayDate in playDate.bundle.playDates|filter(bundledPlayDate => bundledPlayDate.id != playDate.id) %}
                        {{ loop.first ? '' : '<br />' }} {{ bundledPlayDate.date|date('d.m.Y') }} {{ bundledPlayDate.name }}
                    {% endfor %}
                    {% if can_bundle %}
                        {{ include('_shared/_edit_link.html.twig', {url: path('play_date_bundle', {id: playDate.id}), title: "Spieltermine bündeln"|trans}) }}
                    {% endif %}
                    </td>
                </tr>
            {% endif %}
            {% if playDate.super %}
                <tr>
                    <th>{{ 'Super-Spieltermin'|trans }}</th>
                    <td>
                        <i class="bi bi-hand-thumbs-up" title="{{ "Dies ist ein Super-Spieltermin"|trans }}"></i> {{ 'Dies ist ein Super-Spieltermin!'|trans }}
                    </td>
                </tr>
            {% endif %}
            {% if not playDate.specialPlayDateUrl is empty %}
                <tr>
                    <th>{{ 'URL'|trans }}</th>
                    <td>
                        <a href="{{ playDate.specialPlayDateUrl }}">{{ 'Weitere Infos'|trans }}</a>
                    </td>
                </tr>
            {% endif %}
            {% if playDate.training %}
                <tr>
                    <th>{{ 'Anmeldung'|trans }}</th>
                    <td>
                        {% if playDate.playingClowns.contains(currentClown) %}
                            {{ 'Super, Du bist für diesen Termin angemeldet!'|trans }}
                        {% else %}
                            {{ 'Du bist für diesen Termin leider (noch) nicht angemeldet.'|trans }}
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
        </tbody>
    </table>


    {% if playDate.showChangeRequestLink %}
        <a href="{{ path('play_date_new_swap_request', {id: playDate.id}) }}">{{ 'Diesen Spieltermin tauschen'|trans }}</a>&nbsp;
        <a href="{{ path('play_date_new_give-off_request', {id: playDate.id}) }}">{{ 'Diesen Spieltermin abgeben'|trans }}</a>
    {% endif %}
    {% if playDate.showTakeOverRequestLink %}
        <a href="{{ path('play_date_new_take-over_request', {id: playDate.id}) }}">{{ 'Clowns für diesen Spieltermin anfragen'|trans }}</a>
    {% endif %}
    {% if can_bundle and not playDate.bundle %}
        {{ include('_shared/_create_link.html.twig', {url: path('play_date_bundle', {id: playDate.id}), label: "Spieltermine bündeln"|trans}) }}
    {% endif %}
    
    {% if playDate.showRegisterForTrainingLink %}
        {{ form(trainingForm) }}
    {% endif %}

    {% if playDate.playDateGiveOffRequests is not empty or playDate.playDateSwapRequests is not empty%}
        <h5 class="pt-3">{{ 'Tauschanfragen'|trans }}</h5>
        <table class="table">
            <tbody>
                {% for sentChangeRequest in playDate.playDateGiveOffRequests %}
                    <tr>
                        <td>{{ sentChangeRequest.requestedAt|date('d.m.Y') }}</td>
                        {% if sentChangeRequest.isSwap %}
                            <td>
                                {% if sentChangeRequest.requestedBy == currentClown %}
                                    {{ 'Du möchtest diesen Spieltermin an %name% abgeben gegen:'|trans({'%name%': sentChangeRequest.requestedTo.name}) }}
                                {% elseif sentChangeRequest.requestedTo == currentClown and sentChangeRequest.isWaiting %}
                                    {{ '%name% möchte diesen Spieltermin an Dich abgeben gegen:'|trans({'%name%': sentChangeRequest.requestedBy.name}) }}
                                {% else %}
                                    {{ '%name% möchte diesen Spieltermin an %recipient% abgeben gegen:'|trans({'%name%': sentChangeRequest.requestedBy.name, '%recipient%': sentChangeRequest.requestedTo.name}) }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('play_date_show', {id: sentChangeRequest.playDateWanted.id}) }}">
                                    {{ sentChangeRequest.playDateWanted.date|date('d.m.Y') }} {{ sentChangeRequest.playDateWanted.name }} 
                                </a>
                            </td>
                            <td>
                                <i class="badge bg-secondary">{{ sentChangeRequest.status.value|trans }}</i>
                                {% if sentChangeRequest.canAccept(currentClown) and sentChangeRequest.isWaiting %}
                                    <a href="{{ path('play_date_swap_request_accept', {id: sentChangeRequest.id}) }}" class="link-success">{{ 'annehmen'|trans }}</a> {{ 'oder'|trans }}
                                    <a href="{{ path('play_date_swap_request_decline', {id: sentChangeRequest.id}) }}" class="link-danger">{{ 'ablehnen'|trans }}</a>
                                {% elseif sentChangeRequest.canCancel(currentClown) and sentChangeRequest.isWaiting %}
                                    <a href="{{ path('play_date_swap_request_cancel', {id: sentChangeRequest.id}) }}" class="link-danger">{{ 'abbrechen'|trans }}</a>
                                {% endif %}
                            <td>
                        {% elseif sentChangeRequest.isGiveOff %}
                            <td>
                                {% if sentChangeRequest.requestedBy == currentClown %}
                                    {{ 'Du möchtest diesen Spieltermin an %name% abgeben.'|trans({'%name%': sentChangeRequest.requestedTo ? sentChangeRequest.requestedTo.name : 'egal wen'|trans}) }}
                                {% elseif sentChangeRequest.requestedTo == currentClown %}
                                    {{ '%name% möchte diesen Spieltermin an Dich abgeben.'|trans({'%name%': sentChangeRequest.requestedBy.name}) }}
                                {% else %}
                                    {{ '%name% möchte diesen Spieltermin an %recipient% abgeben.'|trans({'%name%': sentChangeRequest.requestedBy.name, '%recipient%': sentChangeRequest.requestedTo ? sentChangeRequest.requestedTo.name : 'egal wen'|trans}) }}
                                {% endif %}
                            </td>
                            <td></td>
                            <td>
                                <i class="badge bg-secondary">{{ sentChangeRequest.status.value|trans }}</i>
                                {% if sentChangeRequest.isAccepted %}
                                    {{ '%name% hat übernommen'|trans({'%name%': sentChangeRequest.requestedTo.name}) }}
                                {% elseif sentChangeRequest.canAccept(currentClown) and sentChangeRequest.isWaiting %}
                                    <a href="{{ path('play_date_give-off_request_accept', {id: sentChangeRequest.id}) }}" class="link-success">{{ 'übernehmen'|trans }}</a>
                                {% endif %}
                            </td>
                        {% elseif sentChangeRequest.isTakeOver %}
                            <td>
                                {{ '%name% hat %recipient% für diesen unterbesetzten Spieltermin angefragt.'|trans({'%name%': sentChangeRequest.requestedBy.name, '%recipient%': sentChangeRequest.requestedTo ? sentChangeRequest.requestedTo.name : 'alle'|trans}) }}
                            </td>
                            <td></td>
                            <td>
                                <i class="badge bg-secondary">{{ sentChangeRequest.status.value|trans }}</i>
                                {% if sentChangeRequest.isAccepted %}
                                    {{ '%name% hat übernommen'|trans({'%name%': sentChangeRequest.requestedTo.name}) }}
                                {% elseif sentChangeRequest.canAccept(currentClown) and sentChangeRequest.isWaiting %}
                                    <a href="{{ path('play_date_take-over_request_accept', {id: sentChangeRequest.id}) }}" class="link-success">{{ 'übernehmen'|trans }}</a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                {% for swapRequest in playDate.playDateSwapRequests %}
                    <tr>
                        <td>{{ swapRequest.requestedAt|date('d.m.Y') }}</td>
                        <td>
                            {% if swapRequest.requestedBy == currentClown %}
                                {{ 'Du möchtest diesen Spieltermin von %name% übernehmen gegen:'|trans({'%name%': swapRequest.requestedTo.name}) }}
                            {% elseif swapRequest.requestedTo == currentClown  %}
                                {{ '%name% möchte diesen Spieltermin von Dir übernehmen gegen:'|trans({'%name%': swapRequest.requestedBy.name}) }}
                            {% else  %}
                                {{ '%name% möchte diesen Spieltermin von %recipient% übernehmen gegen:'|trans({'%name%': swapRequest.requestedBy.name, '%recipient%': swapRequest.requestedTo.name}) }}
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('play_date_show', {id: swapRequest.playDateToGiveOff.id}) }}">
                                {{ swapRequest.playDateToGiveOff.date|date('d.m.Y') }} {{ swapRequest.playDateToGiveOff.name }} 
                            </a>
                        </td>
                        <td>
                            {% if swapRequest.canAccept(currentClown) and swapRequest.isWaiting %}
                                <a href="{{ path('play_date_swap_request_accept', {id: swapRequest.id}) }}" class="link-success">{{ 'annehmen'|trans }}</a> {{ 'oder'|trans }}
                                <a href="{{ path('play_date_swap_request_decline', {id: swapRequest.id}) }}" class="link-danger">{{ 'ablehnen'|trans }}</a>
                            {% else %}    
                                <i class="badge bg-secondary">{{ swapRequest.status.value|trans }}</i>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p class="pt-3">
    <button type="button" class="btn btn-link mb-3 collapse show history" data-bs-target=".history" data-bs-toggle="collapse">{{ 'Historie anzeigen'|trans }}</button>
    <button type="button" class="btn btn-link mb-3 collapse history" data-bs-target=".history" data-bs-toggle="collapse">{{ 'Historie verstecken'|trans }}</button>
       </p> 
    <table class="table collapse history">
        <thead>
            <caption>{{ 'Historie'|trans }}</caption>
            <tr>
                <th>{{ 'Datum'|trans }}</th>
                <th>{{ 'Spielende Clowns'|trans }}</th>
                <th>{{ 'geändert durch'|trans }}</th>
                <th>{{ 'Aktion'|trans }}</th>
        </thead>
        <tbody>
            {% for history in playDate.playDateHistory %}
            <tr>
                <td>{{ history.changedAt|date('d.m.Y H:i') }}</td>
                <td>{{ history.playingClowns|map(clown => clown.name)|join(' | ') }}</td>
                <td>{{ history.changedBy ? history.changedBy.name : 'Spielplan App'|trans }}</td>
                <td>{{ history.reason.value|trans }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
