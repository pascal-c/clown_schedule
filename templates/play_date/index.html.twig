{% extends "base.html.twig" %}

{% block title %}{{ 'Spieltermine'|trans }}{% endblock %}

{% block content %}
    <h4 class="pt-3">{{ 'Spieltermine'|trans }} {{ activeYear }}</h4>

    {{ component('schedule_navigation', { active: 'play_dates_by_year' }) }}
    {{ include('play_date/_year_navigation.html.twig', {activeYear: activeYear, years: years}) }}
    
    <table class="table">
        <thead>
            <tr><th>{{ 'Wann'|trans }}</th><th>{{ 'Wo'|trans }}</th><th>{{ 'Kommentar'|trans }}</th><th>{{ 'Clowns'|trans }}</th><th>{{ 'bearbeiten'|trans }}</th></tr>
        </thead>
        <tbody>

    {% for play_date in play_dates %}
        <tr>
            <td>
                <a href="{{ path('play_date_show', {id: play_date.id}) }}" class="text-dark">{{ play_date.date|date("d.m.Y") }}&nbsp;{{ play_date.daytime }}</a>
            </td>
            <td>
                {{ play_date.name }}<br />
                {{ include('play_date/_status_icons.html.twig', {playDate: play_date}) }}</td>
            <td>
               {% if play_date.super %}
                    <i class="bi bi-hand-thumbs-up" title="{{ "Dies ist ein Super-Spieltermin"|trans }}"></i> {{ 'Super-Spieltermin'|trans }}<br />
                {% endif %}
                {{ play_date.comment }}
            </td>
            <td>
                {% for clown in play_date.playingClowns %}{{ clown.name }} {% endfor %}
            </td>
            <td>{% if currentClown.isAdmin %}<a href="{{ path('play_date_edit', {id: play_date.id}) }}">{{ 'Spieltermin bearbeiten'|trans }}</a>{% endif %}</td>
        </tr>
    {% endfor %}
    </table>
    {% if currentClown.isAdmin %}
        <a href="{{ path('play_date_new') }}">{{ 'Spieltermin anlegen'|trans }}</a>
    {% endif %}
{% endblock %}
